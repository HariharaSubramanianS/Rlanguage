import sqlite3
import pandas as pd

def csv_to_sqlite(HospitalData , medicaldata , hosdata):
    df = pd.read_csv(HospitalData)

    conn = sqlite3.connect(medicaldata)
    df.to_sql( hosdata , conn, if_exists='replace', index=False)

    conn.commit()
    conn.close()
    print(f"CSV data from '{HospitalData}' has been written to '{medicaldata}' in table '{hosdata}'.")



